{
  "name": "grey-matter-education-portal",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Werks Sessions learning and operations portal",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run tests/unit --coverage && npm --prefix functions test",
    "test:rules": "firebase emulators:exec --project demo-werks-sessions --only firestore,storage \"node --test tests/rules/firebase-rules.test.cjs\"",
    "test:e2e": "firebase emulators:exec --project demo-werks-sessions --only auth,firestore,storage \"playwright test\"",
    "smoke:production": "node scripts/smoke-production.mjs",
    "security:secrets": "secretlint --no-color \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "security:gated": "node scripts/check-gated-content.mjs",
    "check:public-bundle": "node scripts/check-public-bundle.mjs",
    "security:deps": "npm audit --omit=dev --audit-level=high && npm --prefix functions audit --omit=dev --audit-level=high",
    "check:handoff": "node scripts/check-staged-handoff.mjs",
    "verify": "npm run lint && npm run format:check && npm run check && npm run test:unit && npm run test:rules && npm run build && npm run check:public-bundle && npm run security:secrets && npm run security:gated && npm run security:deps",
    "verify:staged": "npm run check:handoff && npm run verify",
    "setup:hooks": "node scripts/setup-git-hooks.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "firebase": "firebase",
    "firebase:login": "firebase login",
    "firebase:projects": "firebase projects:list",
    "firebase:use": "firebase use --add",
    "hosting:emulate": "firebase emulators:start --only hosting",
    "hosting:deploy": "firebase deploy --only hosting",
    "hosting:preview": "firebase hosting:channel:deploy preview"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "firebase": "^13.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@secretlint/secretlint-rule-preset-recommend": "^9.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "15.36.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.10.1",
    "secretlint": "^9.3.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
