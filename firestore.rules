rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function accessGrant() { return get(/databases/$(database)/documents/access_grants/$(request.auth.uid)); }
    function hasActiveGrant() {
      return signedIn()
        && exists(/databases/$(database)/documents/access_grants/$(request.auth.uid))
        && accessGrant().data.status == 'active';
    }
    function isAdmin() { return hasActiveGrant() && accessGrant().data.role == 'admin'; }
    function isInstructor() { return hasActiveGrant() && accessGrant().data.role == 'instructor'; }
    function ownsPerson(personId) { return hasActiveGrant() && accessGrant().data.personId == personId; }
    function enrolment(sessionId, uid) { return get(/databases/$(database)/documents/enrolments/$(sessionId + '_' + uid)); }
    function hasConfirmedEnrolment(sessionId, uid) {
      return hasActiveGrant()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/enrolments/$(sessionId + '_' + uid))
        && enrolment(sessionId, uid).data.status == 'confirmed'
        && enrolment(sessionId, uid).data.personId == accessGrant().data.personId;
    }
    function teaches(sessionId) {
      return isAdmin()
        || (isInstructor()
          && exists(/databases/$(database)/documents/teaching_assignments/$(sessionId + '_' + request.auth.uid))
          && get(/databases/$(database)/documents/teaching_assignments/$(sessionId + '_' + request.auth.uid)).data.status == 'active');
    }
    function isCuppingSession(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data.offeringId == 'cupping';
    }
    // Seat contents are bounded by the document size and validated by the client; this record is staff-only,
    // and the Rules expression budget is spent on identity, session, ownership, and record-level limits.
    function nightSeats(seats) {
      return seats is map
        && seats.keys().hasOnly(['s1', 's2', 's3', 's4', 's5', 's6', 's7', 's8', 's9', 's10', 's11', 's12']);
    }
    function validNightRecord(sessionId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['sessionId', 'hostUid', 'status', 'date', 'theme', 'host', 'guests', 'redeemed', 'flight', 'seats', 'tally', 'words', 'notes', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['sessionId', 'hostUid', 'status', 'date', 'theme', 'host', 'guests', 'redeemed', 'flight', 'seats', 'tally', 'words', 'notes', 'createdAt', 'updatedAt'])
        && d.sessionId == sessionId
        && d.status in ['draft', 'final']
        && d.date is string && d.date.size() <= 20
        && d.theme is string && d.theme.size() <= 80
        && d.host is string && d.host.size() <= 80
        && d.guests is int && d.guests >= 0 && d.guests <= 40
        && d.redeemed is int && d.redeemed >= 0 && d.redeemed <= 40
        && d.flight is list && d.flight.size() == 4
        && d.tally is map && d.tally.size() <= 16
        && d.words is list && d.words.size() <= 40
        && d.notes is string && d.notes.size() <= 1000
        && d.updatedAt == request.time
        && nightSeats(d.seats);
    }
    // The one deliberately public document: staff-curated upcoming dates for the front page. It holds no guest
    // data. Item contents are validated by the client and rendered as text; the Rules bound the shape and who writes.
    function validPublicSchedule() {
      let d = request.resource.data;
      return d.keys().hasOnly(['items', 'updatedAt'])
        && d.keys().hasAll(['items', 'updatedAt'])
        && d.items is list && d.items.size() <= 12
        && d.updatedAt == request.time;
    }
    function validNewChallenge(sessionId, uid) {
      return request.resource.data.keys().hasOnly(['sessionId', 'ownerUid', 'personId', 'createdAt', 'updatedAt'])
        && request.resource.data.sessionId == sessionId
        && request.resource.data.ownerUid == uid
        && request.resource.data.personId == accessGrant().data.personId
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }
    function weekText(value) { return value is string && value.size() <= 2000; }
    function validNewWeek(sessionId, uid, weekId) {
      return request.resource.data.keys().hasOnly(['sessionId', 'learnerUid', 'weekId', 'focus', 'coffee', 'recipe', 'tastingNote', 'changeMade', 'complete', 'status', 'updatedAt'])
        && request.resource.data.sessionId == sessionId
        && request.resource.data.learnerUid == uid
        && request.resource.data.weekId == weekId
        && weekId in ['week1', 'week2', 'week3', 'week4']
        && weekText(request.resource.data.focus)
        && weekText(request.resource.data.coffee)
        && weekText(request.resource.data.recipe)
        && weekText(request.resource.data.tastingNote)
        && weekText(request.resource.data.changeMade)
        && request.resource.data.status == 'draft'
        && request.resource.data.complete == false
        && request.resource.data.updatedAt == request.time;
    }
    function nonBlank(value) { return value is string && value.matches('.*[^\\s].*'); }
    function weekComplete(week) {
      return nonBlank(week.focus)
        && nonBlank(week.coffee)
        && nonBlank(week.recipe)
        && nonBlank(week.tastingNote)
        && nonBlank(week.changeMade)
        && week.complete == true;
    }
    // A learner may edit a draft or a returned week, and may submit only a complete week.
    // Submitted and approved weeks are locked for them.
    function validLearnerWeekUpdate() {
      return request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.learnerUid == resource.data.learnerUid
        && request.resource.data.weekId == resource.data.weekId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['focus', 'coffee', 'recipe', 'tastingNote', 'changeMade', 'complete', 'status', 'submittedAt', 'updatedAt'])
        && resource.data.status in ['draft', 'returned']
        && weekText(request.resource.data.focus)
        && weekText(request.resource.data.coffee)
        && weekText(request.resource.data.recipe)
        && weekText(request.resource.data.tastingNote)
        && weekText(request.resource.data.changeMade)
        && (request.resource.data.status == 'draft'
          || (request.resource.data.status == 'submitted' && weekComplete(request.resource.data) && request.resource.data.get('submittedAt', null) == request.time))
        && request.resource.data.updatedAt == request.time;
    }
    // Staff may only decide a submitted week, with non-blank feedback stamped by the server.
    function validStaffWeekReview() {
      return resource.data.status == 'submitted'
        && request.resource.data.keys().hasAll(['status', 'reviewerNote', 'reviewedAt', 'updatedAt'])
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.learnerUid == resource.data.learnerUid
        && request.resource.data.weekId == resource.data.weekId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewerNote', 'reviewedAt', 'updatedAt'])
        && request.resource.data.status in ['approved', 'returned']
        && nonBlank(request.resource.data.get('reviewerNote', ''))
        && request.resource.data.get('reviewedAt', null) == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /public_schedule/{docId} {
      allow get: if docId == 'current';
      allow list, delete: if false;
      allow create, update: if docId == 'current' && (isAdmin() || isInstructor()) && validPublicSchedule();
    }
    match /courses/{course} { allow get, list: if isAdmin(); allow write: if false; }
    match /sessions/{sessionId} {
      allow get: if hasConfirmedEnrolment(sessionId, request.auth.uid) || teaches(sessionId);
      allow list: if false;
      allow write: if false;

      match /guide/main {
        allow get: if hasConfirmedEnrolment(sessionId, request.auth.uid) || teaches(sessionId);
        allow list, write: if false;
      }

      match /night_record/main {
        allow get: if teaches(sessionId);
        allow create: if teaches(sessionId) && isCuppingSession(sessionId) && validNightRecord(sessionId)
          && request.resource.data.hostUid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        // Only the host who created the record, or an administrator, may change it. Another
        // instructor assigned to the same session can read it but not rewrite it.
        allow update: if (request.auth.uid == resource.data.hostUid || isAdmin())
          && teaches(sessionId) && isCuppingSession(sessionId) && validNightRecord(sessionId)
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.createdAt == resource.data.createdAt;
        allow list, delete: if false;
      }

      match /challenges/{uid} {
        allow get, list: if hasConfirmedEnrolment(sessionId, uid) || teaches(sessionId);
        allow create: if hasConfirmedEnrolment(sessionId, uid) && validNewChallenge(sessionId, uid);
        allow update, delete: if false;

        match /weeks/{weekId} {
          // The learner keeps all four own weeks. Staff see only weeks that have been
          // submitted or reviewed, so a draft is never readable by an instructor.
          allow get, list: if hasConfirmedEnrolment(sessionId, uid)
            || (teaches(sessionId) && resource.data.status in ['submitted', 'approved', 'returned']);
          allow create: if hasConfirmedEnrolment(sessionId, uid) && validNewWeek(sessionId, uid, weekId);
          allow update: if (hasConfirmedEnrolment(sessionId, uid) && validLearnerWeekUpdate())
            || (teaches(sessionId) && validStaffWeekReview());
          allow delete: if false;
        }
      }
    }
    // The instructor queue and history page through weeks with a collection-group query
    // constrained to a status staff may see. Drafts never satisfy it, and rules are not
    // filters, so an unfiltered query is refused outright.
    match /{path=**}/weeks/{weekId} {
      allow get, list: if signedIn()
        && teaches(resource.data.sessionId)
        && resource.data.status in ['submitted', 'approved', 'returned'];
      allow write: if false;
    }
    match /access_grants/{uid} { allow get: if signedIn() && request.auth.uid == uid; allow list, write: if false; }
    match /teaching_assignments/{assignmentId} { allow get, list: if isAdmin() || (isInstructor() && resource.data.uid == request.auth.uid); allow write: if false; }
    match /enrolments/{enrolmentId} {
      allow get: if (hasActiveGrant()
        && resource.data.uid == request.auth.uid
        && resource.data.personId == accessGrant().data.personId
        && resource.data.status == 'confirmed')
        || teaches(resource.data.sessionId);
      allow list: if hasActiveGrant()
        && resource.data.uid == request.auth.uid
        && resource.data.personId == accessGrant().data.personId
        && resource.data.status == 'confirmed';
      allow write: if false;
    }
    match /people/{personId} { allow get: if ownsPerson(personId) || isAdmin(); allow list, write: if false; }
    match /learning_records/{record} { allow get: if ownsPerson(resource.data.personId) || isAdmin(); allow list, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
